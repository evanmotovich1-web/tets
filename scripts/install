#!/bin/sh
set -eu
for arg in "$@"; do
  case "$arg" in
    -y|--yes|--non-interactive) TETS_NONINTERACTIVE=1; TETS_NO_MODEL_WIZARD=1; export TETS_NONINTERACTIVE TETS_NO_MODEL_WIZARD ;;
  esac
done
ALGO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
case "$(uname -s)" in
  Darwin) ;;
  Linux) case "$ALGO_ROOT" in /mnt/*) echo 'Use a native Linux filesystem.' >&2; exit 2;; esac;;
  *) echo 'macOS 12+ or native Linux required.' >&2; exit 2;;
esac
if [ ! -t 0 ] && [ "${TETS_NONINTERACTIVE:-0}" != 1 ] && [ -r /dev/tty ]; then
  exec < /dev/tty
fi
if [ -z "${TETS_PROFILE:-}" ]; then
  TETS_PROFILE=normal
  if [ "$(uname -s)" = Darwin ]; then
    TETS_MEMORY=$(sysctl -n hw.memsize 2>/dev/null || printf 0)
    case "$TETS_MEMORY" in ''|*[!0-9]*) TETS_MEMORY=0;; esac
    if [ "$TETS_MEMORY" -gt 0 ] && [ "$TETS_MEMORY" -le 8589934592 ]; then TETS_PROFILE=mac2017; fi
  fi
fi
export TETS_PROFILE
printf '\n╔══════════════════════════════════════════════════════════════════════════════════════════════════╗\n'
printf '║  EVAN ALGO · 1-COMMAND FULL INSTALLER (Profile: %-10s · OS: %-8s · Arch: %-8s)     ║\n' "$TETS_PROFILE" "$(uname -s)" "$(uname -m)"
printf '╚══════════════════════════════════════════════════════════════════════════════════════════════════╝\n'
printf '\n==> [1/8] Bootstrapping private Node 22.23.2 & uv 0.13.1 runtime...\n'
. "$ALGO_ROOT/scripts/bootstrap"
mkdir -p "$ALGO_ROOT/desk/runtime/.state/tets"
printf '%s\n' "$TETS_PROFILE" > "$ALGO_ROOT/desk/runtime/.state/tets/install-profile.txt"
ALGO_VENV="$ALGO_ROOT/desk/backtest/.venv"
[ ! -L "$ALGO_VENV" ] || { echo 'Existing Python symlink refused.' >&2; exit 2; }
printf '\n==> [2/8] Setting up Python 3.14 backtest & ADW environment (%s)...\n' "$ALGO_VENV"
if [ ! -x "$ALGO_VENV/bin/python" ]; then
  rm -rf "$ALGO_VENV"
  uv venv --python 3.14 "$ALGO_VENV"
fi
"$ALGO_VENV/bin/python" -c 'import sys;assert sys.version_info[:2]==(3,14)'
if [ "$ALGO_PLATFORM:$ALGO_ARCH" = Darwin:x86_64 ] || [ "$TETS_PROFILE" = mac2017 ]; then
  echo "Detected Intel Mac (x86_64 / $TETS_PROFILE profile): configuring 2017 Intel Mac native wheels & bounded memory limits."
fi
if [ "$ALGO_PLATFORM:$ALGO_ARCH" = Darwin:x86_64 ]; then
  uv pip sync --python "$ALGO_VENV/bin/python" --python-platform x86_64-apple-darwin --reinstall "$ALGO_ROOT/desk/requirements.lock"
else
  uv pip sync --python "$ALGO_VENV/bin/python" "$ALGO_ROOT/desk/requirements.lock"
fi
"$ALGO_VENV/bin/python" -c 'import subprocess,sys;subprocess.run([sys.executable,"-c","import numpy,pandas,backtesting,rfc8785"],check=True,timeout=180)'
printf '\n==> [3/8] Installing Node desk runtime packages (npm ci)...\n'
(cd "$ALGO_ROOT/desk" && npm ci --ignore-scripts --no-audit --no-fund)
printf '\n==> [4/8] Installing Yahoo Shadow live market engine (Python 3.14)...\n'
"$ALGO_VENV/bin/python" "$ALGO_ROOT/scripts/shadow.py" install
printf '\n==> [5/8] Preparing Alpaca Paper Trading engine (Python 3.13 · live_orders=false)...\n'
"$ALGO_VENV/bin/python" "$ALGO_ROOT/scripts/paper.py" prepare
"$ALGO_ROOT/desk/runtime/.state/shadow/.venv/bin/python" -c 'import yfinance,numpy,pandas,backtesting'
printf '\n==> [6/8] Terminal Setup: Strategy, Alpaca Paper API Key & AI Model / Subscription Wizard...\n'
SHADOW_PY="$ALGO_ROOT/desk/runtime/.state/shadow/.venv/bin/python"
[ -x "$SHADOW_PY" ] || SHADOW_PY="$ALGO_VENV/bin/python"
if [ -t 0 ] && [ "${TETS_NONINTERACTIVE:-0}" != 1 ] && [ "${TETS_NO_MODEL_WIZARD:-0}" != 1 ]; then
  TETS_SKIP_LEGACY_AI_PROMPT=1 sh "$ALGO_ROOT/tets" setup
  "$SHADOW_PY" "$ALGO_ROOT/scripts/harness2_evolve.py" model wizard || true
else
  sh "$ALGO_ROOT/tets" setup < /dev/null
fi
printf '\n==> [7/8] Initializing Harness² 6-Agent ADW, Saved Backtest Replay & Hermes Agent + CLI symlinks...\n'
"$SHADOW_PY" "$ALGO_ROOT/scripts/replay_workbench.py" >/dev/null 2>&1 || true
"$SHADOW_PY" "$ALGO_ROOT/scripts/harness2_evolve.py" visual >/dev/null 2>&1 || true
mkdir -p "$HOME/.local/bin" 2>/dev/null || true
if [ -d "$HOME/.local/bin" ]; then
  ln -sf "$ALGO_ROOT/algo" "$HOME/.local/bin/algo" 2>/dev/null || true
  ln -sf "$ALGO_ROOT/adw" "$HOME/.local/bin/adw" 2>/dev/null || true
  ln -sf "$ALGO_ROOT/tets" "$HOME/.local/bin/tets" 2>/dev/null || true
  PATH="$HOME/.local/bin:$PATH"
  export PATH
  for RC_FILE in "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc"; do
    if [ -f "$RC_FILE" ] || [ "$RC_FILE" = "$HOME/.zshrc" ]; then
      if ! grep -qs '\.local/bin' "$RC_FILE" 2>/dev/null; then
        printf '\n# Added by Evan Algo installer\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$RC_FILE" 2>/dev/null || true
      fi
    fi
  done
fi
if [ "${TETS_SKIP_HERMES:-0}" != 1 ] && [ "${TETS_NO_START:-0}" != 1 ] && ! command -v hermes >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/hermes" ]; then
  printf '\n==> [7b/8] Installing Hermes Agent (NousResearch/hermes-agent)...\n'
  mkdir -p "$HOME/.hermes"
  rm -rf "$HOME/.hermes"/.hermes-clone-* 2>/dev/null || true
  if [ ! -d "$HOME/.hermes/hermes-agent/.git" ]; then
    rm -rf "$HOME/.hermes/hermes-agent" 2>/dev/null || true
    HERMES_TAG=$(curl -fsSI --connect-timeout 5 --max-time 15 https://github.com/NousResearch/hermes-agent/releases/latest 2>/dev/null | tr -d '\r' | sed -n 's#^[Ll]ocation:.*/releases/tag/\([^/]*\)$#\1#p' | tail -n 1)
    [ -n "$HERMES_TAG" ] || HERMES_TAG="v0.22.5"
    printf '  Pre-cloning Hermes Agent (%s) over HTTP/1.1 shallow pack (bypasses macOS HTTP/2 & promisor bug)...\n' "$HERMES_TAG"
    git -c http.version=HTTP/1.1 -c http.postBuffer=524288000 clone --progress --depth 1 --branch "$HERMES_TAG" https://github.com/NousResearch/hermes-agent.git "$HOME/.hermes/hermes-agent" || true
  fi
  if [ -f "$HOME/.hermes/hermes-agent/scripts/install.sh" ]; then
    bash "$HOME/.hermes/hermes-agent/scripts/install.sh" --non-interactive || \
      bash "$HOME/.hermes/hermes-agent/scripts/install.sh" --non-interactive --skip-browser || true
  else
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive || true
  fi
fi
printf '\n==> [8/8] Verifying hardware & connections, then starting Evan Algo dashboard...\n'
sh "$ALGO_ROOT/tets" verify-hardware
sh "$ALGO_ROOT/tets" doctor
if [ "${TETS_NO_START:-0}" != 1 ]; then exec sh "$ALGO_ROOT/tets" start; fi
echo 'Installed. Start with: sh tets start'
